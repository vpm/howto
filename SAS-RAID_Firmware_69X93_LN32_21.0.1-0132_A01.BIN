# Implement script security, only on Linux systems
#  - sanitize IFS
#  - insure 'unalias' is not a funcion
#  - unset all aliases and quote unalias so it is not alias-expanded
#  - insure 'command' is not a function
#  - sanitize PATH 
[ "$(uname -s)" == "Linux" ] && {
    IFS=$' \t\n'
    unset -f unalias
    \unalias -a
    unset -f command
    SYSPATH="$(command -p getconf PATH 2>/dev/null)"
    [ -z "$SYSPATH" ] && SYSPATH="/usr/bin:/bin"
    PATH="$SYSPATH:/sbin"
}

# Set umask
umask 0022

# Global constants - readonly variables
typeset -ri _TRUE=0
typeset -ri _FALSE=1

# Interactive command line flags and boolean functions
typeset -i _VAL_NO_TERMINAL=$_FALSE
typeset -i _VAL_QUIET=$_FALSE
typeset -i _DEP_WARNING=$_FALSE
typeset -i _VAL_ALLOW_INSECURE_EXEC=$_FALSE
bQuiet() {
    [ $_VAL_QUIET -eq $_TRUE ]
}
bNoTerminal() {
    [ $_VAL_NO_TERMINAL -eq $_TRUE ]
}
bDependecyWarning() {
    [ $_DEP_WARNING -eq $_TRUE ]
}
bAllowInsecureExec() {
    [ $_VAL_ALLOW_INSECURE_EXEC -eq $_TRUE ]
}

# Determine if the application has been launched from an xterm or XWindows
[ -z "$TERM" ] && TERM=vt100
case $TERM in 
    # rxvt is a background terminal for Novell
    # nutc, ansi, vt100, screen are standard display terminals
    rxvt* | nutc* | ansi* | vt100* | screen*) # Do nothing
        ;;
    dumb* | linux*)
        [ -n "$DISPLAY" -a -n "$XAUTHORITY" ] && {
            tty --quiet || exec xterm +ls -e $0 $@ || $0 $@
        }
        ;;
    # This will cause interactive DUPs to re-launch in an xterm window 
    # if stdin is not a terminal
    xterm*) 
        tty --quiet || _VAL_NO_TERMINAL=$_TRUE
        ;;
    *) exec xterm +ls -e $0 $@
        ;;
esac

# Unset LD_PRELOAD to allow OS routines that use threading to work.
unset LD_PRELOAD

typeset -r _CURRDIR=$PWD

# width for console text output formatting
typeset -i _WIDTH=100

# Exit Codes
typeset -ri _EXECUTION_SUCCESS=0
typeset -ri _EXECUTION_UNSUCCESS=1
typeset -ri _SECURITY_ERROR=9

# Embedded files and markers
typeset -r _PACKAGE_GENERATOR="sezgen.sh"
typeset -r _PACKAGE_NL="uni-eol.txt"
typeset -r _MANIFEST_XML="package.xml"
typeset -r _DUP_ARCHIVE="archive.tar.gz"
typeset _MANIFEST_XML_MARKER="#####Startofpackage#####"
typeset _DUP_ARCHIVE_MARKER="#####Startofarchive#####"

# Files and File prefixes
typeset -r _TMPFILE_PREFIX="/tmp/.dellSez"
typeset -r _INSTALLER=spsetup.sh
typeset -r _VERSION_TEXT="Version.txt"
typeset -r _HELP_TEXT="sphelp.txt"
typeset -r _MANIFEST_XSL="package.xsl"
typeset -r _SPCONFIG_XSL="spconfig.xsl"
typeset -r _PIECONFIG_XSL="PIEConfig.xsl"
typeset -r _SPCONFIG_XML="spconfig.xml"
typeset -r _PIECONFIG_XML="PIEConfig.xml"
typeset -r _DISNEY_INSTALL="disneyinstall.sh"
typeset -r _PIECONFIG_SCRIPT="PIEConfig.sh"

# Other constants
typeset -i _VERBOSE=0
typeset -r _ROOT_UID=0     # Only customers with $UID 0 have root privileges.
typeset -r _CMDOPTS="$(printf "%s" "$*")"
typeset -r _REBUILT_PKG_SFX="-CUSTOM"
typeset -r _REBUILT_BASE_DIR=AddnKernelSupport
typeset -r _DKS_BASE_DIR=/var/omsa/dks
typeset -ri _EXIT_DELAY=1 # gives customers a chance to read output on temporary terminals 

# Currently there are 2 HAPI device drivers: dell_rbu and dcdbas
typeset -r _HAPI_DRIVERS="dell_rbu dcdbas"

# XML stylesheet transformer
typeset -r _WIN_XSLTPROC="xsltproc.js"
which xsltproc > /dev/null 2>&1 && _TMP_XSLTPROC="$(which xsltproc)"
which cscript > /dev/null 2>&1  && _TMP_XSLTPROC="cscript /b $_WIN_XSLTPROC"
typeset -r _XSLTPROC="$_TMP_XSLTPROC"

# Global modifiables
typeset -i _PACKAGE_STATUS=0
typeset _TEMP_PACKAGE_GENERATOR
typeset _TEMP_MANIFEST_XML
typeset _TEMP_ARCHIVE
typeset _DUP_PACKAGE_NAME
typeset _PAYLOAD_DIR

# Command line flags and boolean functions
typeset -i _VAL_HELP=$_FALSE
typeset -i _VAL_VERSION=$_FALSE
typeset -i _VAL_LIST=$_FALSE
typeset -i _VAL_LISTXML=$_FALSE
typeset -i _VAL_EXTRACT=$_FALSE
typeset -i _VAL_EXTRACT_DELL=$_FALSE
typeset -i _VAL_REBUILD=$_FALSE
typeset -i _VAL_DUP_PACKAGE_NAME=$_FALSE
typeset -i _VAL_PAYLOAD_DIR=$_FALSE
bHelp() {
    [ $_VAL_HELP -eq $_TRUE ]
}
bVersion() {
    [ $_VAL_VERSION -eq $_TRUE ]
}
bList() {
    [ $_VAL_LIST -eq $_TRUE ]
}
bListXml() {
    [ $_VAL_LISTXML -eq $_TRUE ]
}
bExtract() {
    [ $_VAL_EXTRACT -eq $_TRUE ]
}
bExtractDell() {
    [ $_VAL_EXTRACT_DELL -eq $_TRUE ]
}
bRebuild() {
    [ $_VAL_REBUILD -eq $_TRUE ]
}
bDupPackage() {
    [ $_VAL_DUP_PACKAGE_NAME -eq $_TRUE ]
}
bPayloadDir() {
    [ $_VAL_PAYLOAD_DIR -eq $_TRUE ]
}

# In DUP 2.0, 64-bit platform blocking is not in effect.
typeset -i _TEST_FOR_64_BIT_PLATFORMS=$_FALSE
bTestFor64BitPlatforms() {
    [ $_TEST_FOR_64_BIT_PLATFORMS -eq $_TRUE ]
}

# Prints an unformatted message
_msg() {
    typeset opts=""
    [ "$(echo -e)" != "-e" ] && opts="-e"
    typeset line=""
    for arg in "$@"; do
        line=$line$arg
    done
    echo $opts "$line"
}

# Prints a formatted message
msgFmt() {
    _msg "$@" | fmt -s -w $_WIDTH
}

# Prints a formatted error message to stderr then exits false
msgErr() {
    msgFmt "$_PACKAGENAME Error: " "$@" >&2
    exit $_EXECUTION_UNSUCCESS
}

# Interactively asks customer for a yes or no answer.
# This is secure since 'look' is not used to obtain message strings.
# returns true if Yes, otherwise false.
bSecureContinueYes() {
    typeset -r _MSG_PROMPT_CONTINUE="Continue executing? Y/N:"
    typeset -r _MSG_PROMPT_WRONG_CHOICE="Wrong choice. Enter Y/N:\n"
    typeset var=invalid
    typeset badChoice=""
    while [ N != "${var}" -a Y != "${var}" -a n != "${var}" -a y != "${var}" ]; do
        echo -en $badChoice
        read -p "$_MSG_PROMPT_CONTINUE" var
        var=$(echo ${var:-invalid} | tr '[:lower:]' '[:upper:]')
        badChoice="$_MSG_PROMPT_WRONG_CHOICE"
    done
    [ $var = Y -o $var = y ]
}

# Interactively issue messages when dependent utilities are compromised.
issueSecurityPrompt() {
    ! bDependecyWarning && return

cat <<EO_RPM_MSG >&2
rpm verify output legend:
       . verification test passed
       S file Size differs
       M Mode differs (includes permissions and file type)
       5 MD5 sum differs
       D Device major/minor number mismatch
       L readLink(2) path mismatch
       U User ownership differs
       G Group ownership differs
       T mTime differs
EO_RPM_MSG

    ! bSecureContinueYes && {
        _msg "Stopping DUP execution"
        exit $_SECURITY_ERROR
    }
}

# Function verifies the security of the dependent utilities
verifySecurity() {
    # only verify on Linux systems - not mks or cygwin
    [ "$(uname -s)" == "Linux" ] || return
    typeset _dep
    typeset _rpm_err_msg
    typeset -a _RPM_ERRORS

    # Get quiet and security override options for security verification.
    # Ignore getopts errors.
    while getopts ":qn" Option ${_CMDOPTS}; do
    case $Option in
        q) _VAL_QUIET=$_TRUE
            ;;
        n) _VAL_ALLOW_INSECURE_EXEC=$_TRUE
            ;;
        *)
            ;;
    esac
    done

    # Make sure all the dependencies are available on the system
    which $@ >/dev/null || {
        _msg "Cannot find utilities on the system to execute package.\n" \
        "Make sure the following utilities are in the path:\n" "$@" >&2
        exit $_EXECUTION_UNSUCCESS
    }

    # Use rpm verification to identify security risks in dependent utilities
    # Only flag any changes in mode, user ownership, or group ownership 
    typeset -i _err_ix=1
    for _dep in $@; do
        typeset _fullPath=$(which $_dep)
        typeset _rpm_str=$(rpm --verify -f $_fullPath \
            | grep $_fullPath \
            | grep -E -e ".M......|......G.|.....U..") 
        [ -z "$_rpm_str" ] || {
            _RPM_ERRORS[$_err_ix]="rpm verify failed: $_rpm_str"
            ((_err_ix++))
            _DEP_WARNING=$_TRUE
        }
    done

    if bQuiet ; then
        bDependecyWarning && {
            bAllowInsecureExec || exit $_SECURITY_ERROR
        }
    else # interactive:
        for _rpm_err_msg in "${_RPM_ERRORS[@]}"; do
            _msg "$_rpm_err_msg" >&2
        done
        if bAllowInsecureExec; then
            bDependecyWarning && _msg "Continuing execution"
        else
            issueSecurityPrompt
        fi
    fi
}

# Function is the interrupted exit point for the script
InterruptScript() {
    exit $1
}

# Verify if the required amount of disk
# space (in K) is available on the host system.
chk_Free_Space() {
    [ "$(uname -s)" == "Linux" ] || return
    [ -f /VERSION -o -f /VER_INFO ] && return # bypass on ELI
    typeset dir=$1 # folder to verify
    typeset -ri space_k=$2
    typeset -ri space_m=$(($space_k/1024))
    
    # For embedded linux (ELI), total used + available space == 0.
    # Return without error on ELI.
    typeset -ri blockSize=$(stat -f -c%s $dir)
    typeset -ri totalBlocks=$(stat -f -c%b $dir)
    typeset -ri total_space_m=$(($totalBlocks*$blockSize/(1024*1024)))
    [ ${total_space_m:-0} -eq 0 ] && return
    
    typeset -ri availableBlocks=$(stat -f -c%a $dir)
    typeset -ri freespace_k=$(($availableBlocks*$blockSize/1024))

    if [ ${freespace_k:-0} -lt $space_k ]; then
        df -Pm $dir
        msgErr  "Not enough space available in $dir folder.\n" \
            "Please make sure you have at least ${space_m}MB " \
            "of free space available in the $dir folder."
    fi
}

# Function is the common exit point for the script
EndScript() {
    typeset -i iRc=$?
    [ -d $_TEMPDIR ] &&  find $_TEMPDIR | xargs chmod 1700
    rm -rf $_TEMP_ARCHIVE $_TEMP_PACKAGE_GENERATOR $_TEMP_MANIFEST_XML $_TEMPDIR 2> /dev/null

    sleep $_EXIT_DELAY
    trap '' EXIT

    # Change to current directory
    cd "$_CURRDIR" > /dev/null 2>&1

    exit $iRc
}

# Concatenates Sez generator script, package.xml, and tar archive files into Dup package
_buildPackage() {
    [ $# -eq 3 ] || msgErr "_buildPackage: requires 3 files"
    [ -f $1 ] || msgErr "_buildPackage: $1 is not a regular file"
    [ -f $2 ] || msgErr "_buildPackage: $2 is not a regular file"
    [ -f $3 ] || msgErr "_buildPackage: $3 is not a regular file"
    cat "$1" || return $?
    echo
    echo $_MANIFEST_XML_MARKER
    cat "$2" $_PACKAGE_NL || return $?
    echo
    echo $_DUP_ARCHIVE_MARKER
    cat "$3" || return $?
}

# Finds the line number of a marker in the Dup package file
_getMarkerLine() {
    grep -m1 -an "^$1" $_PACKAGENAME | cut -d ":" -f 1
}

# Extracts the Sez generator script, package.xml, or tar archive file from the Dup package file
_extract() {
    typeset -i iManifest=$(_getMarkerLine "$_MANIFEST_XML_MARKER")
    typeset -i iArchive=$(_getMarkerLine "$_DUP_ARCHIVE_MARKER")
    typeset -i iDupGen1=iManifest-2
    typeset -i iPackage0=iManifest+1
    typeset -i iPackage1=iArchive-2
    typeset -i iArchive0=iArchive+1
    case $1 in
    "$_PACKAGE_GENERATOR")
        #msgFmt "$1 offset to end: 0 to ${iDupGen1}" >&2
        head -n ${iDupGen1} $_PACKAGENAME
        ;;
    
    "$_MANIFEST_XML")
        #msgFmt "$1 offset to end: ${iPackage0} to ${iPackage1}" >&2
        head -n ${iPackage1} $_PACKAGENAME | tail -n +${iPackage0}
        ;;
    
    "$_DUP_ARCHIVE")
        #msgFmt "$1 offset: ${iArchive0}" >&2
        tail -n +${iArchive0} $_PACKAGENAME
        ;;

    *)
        msgErr "Tried to extract $1: can only extract package.xml or sampleexecution.bin"
        ;;
    esac
}

# Builds the PIE script used by the installer (spsetup.sh)
buildPIEScript() {
    echo "#!/bin/bash"
    $_XSLTPROC $_MANIFEST_XSL $_MANIFEST_XML || return $?
    $_XSLTPROC $_SPCONFIG_XSL $_SPCONFIG_XML || return $?
    $_XSLTPROC $_PIECONFIG_XSL $_PIECONFIG_XML || return $?
    # remove unnecessary files from the framework
    rm -f $_WIN_XSLTPROC 
    rm -f $_MANIFEST_XSL 
    rm -f $_SPCONFIG_XSL $_SPCONFIG_XML
    rm -f $_PIECONFIG_XSL $_PIECONFIG_XML
}

# Escape quotes in the pkgDescription entry in the PIEConfig script.
correctPIEConfigScript() {
    typeset _TEMP_PIECONFIG_SCRIPT=PIECONFIG$$-$RANDOM ||
        msgErr "Cannot create temporary file - _TEMP_PIECONFIG_SCRIPT "
    cat $_PIECONFIG_SCRIPT |  sed -E -e '
    /^pkgDescription/s,"\s*$,,g;
    /^pkgDescription/s,^pkgDescription=",pkgDescription=,g;
    /^pkgDescription/s,",\\",g;
    /^pkgDescription/s,^pkgDescription=,pkgDescription=",g;
    /^pkgDescription/s,\s*$,",g;' > $_TEMP_PIECONFIG_SCRIPT
    mv $_TEMP_PIECONFIG_SCRIPT $_PIECONFIG_SCRIPT 
}

verifyPIEExecutables() {
    . ./${_PIECONFIG_SCRIPT}
    [ -f $_PAYLOAD_DIR/$sInventoryCliBin ] ||
        msgErr "Inventory Cli binary does not exist: $_PAYLOAD_DIR/$sInventoryCliBin"
    [ -f $_PAYLOAD_DIR/$sExecutionCliBin ] ||
        msgErr "Execution Cli binary does not exist: $_PAYLOAD_DIR/$sExecutionCliBin"
}

# Corrects non-displayables in Version.txt
convertVersionFile() {
    typeset _TEMP_VERSION_FILE=Version$$-$RANDOM ||
        msgErr "Cannot create temporary file - _TEMP_VERSION_FILE "
    # Change double-quotes
    cat Version.txt | \
        tr "\223" "\042" | tr "\224" "\042" > $_TEMP_VERSION_FILE
    mv $_TEMP_VERSION_FILE Version.txt
}

# Generates a new Dup package file
generateNewDup() {
    typeset currDir=$PWD # original directory

    (bDupPackage && ! bPayloadDir) || (bPayloadDir && ! bDupPackage) &&
        msgErr "Must specify --package and --payload options to generate a new DUP package."

    ! (bDupPackage && bPayloadDir) && return # Build of new Dup not requested

    # DUP package must not overwrite the SEZ generator
    [ $_DUP_PACKAGE_NAME != $_PACKAGE_GENERATOR ] || 
        msgErr "Dup Package name cannot equal $_PACKAGE_GENERATOR"

    typeset -r _DUP_TARGET="$_PAYLOAD_DIR/../_DUP_PACKAGE_NAME"
    [ -h "${_DUP_TARGET%/}" ] && 
        msgErr "Security risk; DUP package file is a symbolic link: $_DUP_TARGET"
    touch $_DUP_TARGET ||
        msgErr "Unable to create DUP Package file." \
        "Please check permissions on the output directory" 
    test -f $_DUP_TARGET && rm -f $_DUP_TARGET

    typeset vopt
    ## Prep payload files for archive
    cd $_PAYLOAD_DIR
    [ -e dos2unix.exe ] || msgErr "Could not find dos2unix.exe in $_PAYLOAD_DIR"
    [ -e $_MANIFEST_XML ] || msgErr "Could not find $_MANIFEST_XML in $_PAYLOAD_DIR"

    # Build the PIE script from xml files, move it to the framework folder
    [ -h "${_PIECONFIG_SCRIPT%/}" ] && 
        msgErr "Security risk; PIEConfig script is a symbolic link: $_PIECONFIG_SCRIPT"
    buildPIEScript > $_PIECONFIG_SCRIPT || msgErr "Cannot build $_PIECONFIG_SCRIPT"
    correctPIEConfigScript || msgErr "Error correcting $_PIECONFIG_SCRIPT"
    verifyPIEExecutables
    mv $_PIECONFIG_SCRIPT ./framework

    # Move sezgen package generator and xsltproc.js to parent dir.
    # They do not belong in the archive tarball.
    mv $_PACKAGE_GENERATOR .. ||
        msgErr "Cannot move file $_PACKAGE_GENERATOR in $_PAYLOAD_DIR to .."
    mv $_PACKAGE_NL .. ||
        msgErr "Cannot move file $_PACKAGE_NL in $_PAYLOAD_DIR to .."

    # Convert shell and text files to Unix format
    typeset _DOS_2_UNIX
    typeset vopt=""
    [ -e dos2unix.exe ] && _DOS_2_UNIX="./dos2unix.exe"
    [ "$(uname -s)" == "Linux" ] && _DOS_2_UNIX=$(which dos2unix)
    [ "$(uname -s)" == "Linux" ] && vopt='-q'
    [ $_VERBOSE -eq 1 ] && vopt=""

    find . -name "*.sh" | xargs chmod 775 
    find . -name "*.sh" | xargs -I '{}' $_DOS_2_UNIX $vopt '{}' || msgErr "Cannot fix script files in $_PAYLOAD_DIR"

    find . -name "*.txt" | xargs chmod 775 
    $_DOS_2_UNIX $vopt Version.txt  || msgErr "Cannot fix Version.txt file in $_PAYLOAD_DIR"
    convertVersionFile

    # Move dos2unix.exe to parent dir.
    # It does not belong in the archive tarball.
    [ -e dos2unix.exe ] && {
        mv dos2unix.exe .. ||
            msgErr "Cannot move file dos2unix.exe in $_PAYLOAD_DIR to .."
    }

    # Leave a copy of the manifest xml (package.xml) in the payload dir
    # in order to include it in the archive tarball.
    cp $_MANIFEST_XML .. || msgErr "Cannot copy file $_MANIFEST_XML in $_PAYLOAD_DIR to .."

    ## Build archive
    vopt=""
    [ $_VERBOSE -eq 1 ] && vopt=v
    [ -h "{$_DUP_ARCHIVE%/}" ] && 
        msgErr "Security risk;  $_DUP_ARCHIVE is a symbolic link"
    tar -c${vopt}zf $_DUP_ARCHIVE * || msgErr "Unable to create $_DUP_ARCHIVE tar file in $_PAYLOAD_DIR"
    mv $_DUP_ARCHIVE ..

    ## Create DUP in parent dir of the payload dir
    cd ..
    _buildPackage "$_PACKAGE_GENERATOR" "$_MANIFEST_XML" "$_DUP_ARCHIVE" > $_DUP_PACKAGE_NAME || {
        rm $_DUP_ARCHIVE
        msgErr "Unable to build Dup Package: $_DUP_PACKAGE_NAME"
    }
    chmod 766 $_DUP_PACKAGE_NAME
    rm $_DUP_ARCHIVE
    cd $currDir # Return to the original directory

    exit $_EXECUTION_SUCCESS
}

# returns true if pathname is relative
# $1 is the pathname to evaluate
isRelative() {
    case "$1" in
        [\\/]* | ?:[\\/] ) return 1;;
        *) return 0;;
    esac
}

# returns the full pathname of a folder
# $1 is the folder name evaluate
getFullPath() {
    cd "$1" >/dev/null 2>&1
    local folder="$PWD"
    cd - >/dev/null 2>&1
    echo $folder
}

# finds and returns the first valid directory in a folder name
# $1 is the folder name to search
findPath() {
    local folder="$1"
    isRelative "$folder" && {
        folder="$PWD/$folder"
    }
    # Note: last folder in loop is the root folder, /
    while [ "$(dirname "$folder")" != "$folder" ];do
        test -d "$folder" && {
            folder="$(getFullPath "$folder")"
            break
        }
        folder="$(dirname "$folder")"
    done
    echo $folder
}

# Function is used to verify the extraction folder
createExtractDir() {
    typeset _CREATE_EXTRACT_DIR="$1"

    # FILE exists but isn't a directory
    [ -f "$_CREATE_EXTRACT_DIR" ] &&
        msgErr "File already exists: $_CREATE_EXTRACT_DIR"
    # FILE is a directory but is a symbolic link
    [ -h "${_CREATE_EXTRACT_DIR%/}" ] &&
        msgErr "Security risk; directory is a symbolic link: $_CREATE_EXTRACT_DIR"

    # Make the extract dir if it does not already exist
    [ -d "$_CREATE_EXTRACT_DIR" ] || {
        mkdir -p --mode=1700 "$_CREATE_EXTRACT_DIR" >/dev/null 2>&1 ||
            msgErr "Cannot create directory $_CREATE_EXTRACT_DIR.  "\
                "Please ensure there is enough space."
    }

    typeset _ABSPATH="$(findPath "$_CREATE_EXTRACT_DIR")"
    test -w "$_ABSPATH" ||
        msgErr "Cannot extract package to directory $_CREATE_EXTRACT_DIR.  "\
            "Directory is not writable: $_ABSPATH"
    test -O "$_ABSPATH" ||
        msgErr "Cannot extract package to directory $_CREATE_EXTRACT_DIR.  "\
            "$(id -un) is not owner of directory: $_ABSPATH"

    # Directory already exists. Overwrite the contents.
    if [ -d "$_CREATE_EXTRACT_DIR" ]; then
         chmod u+w "$_CREATE_EXTRACT_DIR" # Give it write permissions
    fi
}

# Function is used to extract the contents of the archive
extractDell() {
    typeset _EXTRACT_DIR="$1"
    createExtractDir "$_EXTRACT_DIR"

    _TEMP_ARCHIVE=$(mktemp $_TMPFILE_PREFIX-$_PACKAGENAME$RANDOM.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_ARCHIVE "

    [ "$(uname -s)" == "Linux" ] && {
        # Verify existence of enough space to extract archive
        typeset -ri _DUP_SIZE=$(stat -c%s $_PACKAGENAME)
        typeset -ri _DUP_SIZE_K=$(($_DUP_SIZE/1024))
        # chk_Free_Space folder_to_verify required_minimum_kbytes 
        chk_Free_Space /tmp $_DUP_SIZE_K
    }

    # Extract archive
    _extract "$_DUP_ARCHIVE" > $_TEMP_ARCHIVE 2>/dev/null ||
        msgErr "extract(): Unable to create temporary files. " \
            "Please ensure that there is enough space in the tmp folder."

    [ "$(uname -s)" == "Linux" ] && {
        # Verify existence of enough space to unzip and untar archive
        typeset -ri _FULL_ARCHIVE_SIZE=$(GZIP='-q' zcat $_TEMP_ARCHIVE | wc -c)
        # Remove archive to accurately measure space required by archive and un-tarred archive
        rm -f $_TEMP_ARCHIVE
        # Add a 1 megabyte buffer to the required minimum
        typeset -i _TMP_REQUIRED_SPACE_MINIMUM_K=$(((${_FULL_ARCHIVE_SIZE} + 1024 * 1024)/1024))
        let _TMP_REQUIRED_SPACE_MINIMUM_K+=$_DUP_SIZE_K
        # chk_Free_Space folder_to_verify required_minimum_kbytes 
        chk_Free_Space /tmp $_TMP_REQUIRED_SPACE_MINIMUM_K

        # re-extract removed archive
        _extract "$_DUP_ARCHIVE" > $_TEMP_ARCHIVE 2>/dev/null ||
            msgErr "extract(): Unable to create temporary files. " \
                "Please ensure that there is enough space in the tmp folder."
    }

    typeset vopt
    # optionally echo commands via v option
    [ $_VERBOSE -eq 1 ] && vopt=v
    GZIP="-q" tar -x${vopt}zf $_TEMP_ARCHIVE -C "$_EXTRACT_DIR" >/dev/null 2>&1 || {
         [ $? -eq 2 ] || # ignore gzip warnings, indicated by return code == 2
             msgErr "The archive cannot be extracted. Please ensure that the " \
             "archive is not corrupted and there is enough space in the tmp folder."
    }
    cd "$_EXTRACT_DIR" > /dev/null 2>&1
    chmod 1555 *
    [ -d framework ] && {
        find framework | xargs chmod 1555 
    }
    cd - > /dev/null 2>&1
}

# Function is used to extract the contents of the archive
# and to move the DUP framework files to the working folder
extract() {
    typeset _EXTRACT_DIR="$1"
    extractDell "$_EXTRACT_DIR"
    cd "$_EXTRACT_DIR" > /dev/null 2>&1
    # move framework files to current folder
    [ -d framework ] && {
        find framework | xargs chmod 1755
        mv framework/* .
        rm -rf framework > /dev/null 2>&1
        find . | xargs chmod 1555
    }
    cd - > /dev/null 2>&1
}

# Print the manifest (package.xml) from the Dup Package.
# Print the formatted file via xmllint if possible, otherwise use cat.
printManifestXml() {
    _TEMP_MANIFEST_XML=$(mktemp $_TMPFILE_PREFIX-$_MANIFEST_XML$RANDOM.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_MANIFEST_XML "
    _extract "$_MANIFEST_XML" > $_TEMP_MANIFEST_XML ||
        msgErr "printManifestXml(): Unable to create temporary files. " \
            "Please ensure that there is enough space in the tmp folder."
    which xmllint > /dev/null 2>&1 && xmllint --format $_TEMP_MANIFEST_XML && return
    cat $_TEMP_MANIFEST_XML
}

# Executes a package from a console
executePackage() {
    typeset _PACKAGE_DIR=$1
    shift
    export LD_LIBRARY_PATH=$_PACKAGE_DIR:$LD_LIBRARY_PATH
    cd $_PACKAGE_DIR > /dev/null 2>&1
    chmod -R 1755 $_PACKAGE_DIR/*  # read execute permission for extracted package

    # pass on shell tracing options
    typeset opt
    typeset -i ixOpt=0
    echo $SHELLOPTS | grep "xtrace" >/dev/null 2>&1 && opt[$((ixOpt++))]='-x'
    echo $SHELLOPTS | grep "verbose" >/dev/null 2>&1  && opt[$((ixOpt++))]='-v'
    if [ -z $_XTERMAPP ]; then
        sh ${opt[@]} $_PACKAGE_DIR/$_INSTALLER $@
    else
        # Execute the package from a console
        opt[$((ixOpt++))]='-c'
        xterm -hold +ls -e "sh ${opt[@]} $_PACKAGE_DIR/$_INSTALLER" $@
    fi
    _PACKAGE_STATUS=$?
    cd - > /dev/null 2>&1 # Return to the original directory
}

# returns true if any of the HAPI device drivers are currently built into
# the kernel
areHapiDriversBuiltIn() {
    typeset _DRIVER_NAME=""
    typeset _LOADED_DIR_NAME=""
    typeset -i _DRIVER_BUILTIN=$_FALSE

    # Loop on the list of HAPI drivers.
    for _DRIVER_NAME in $_HAPI_DRIVERS; do
        # Set the directory location of the current driver for this loop.
        _LOADED_DIR_NAME="/sys/devices/platform/${_DRIVER_NAME}"

        # Check if the driver is built into the kernel.
        # We can identify that a driver is built into the kernel if the
        # following two are true:
        # (1) A directory for the driver exists in the "/sys/devices/platform"
        #     directory, and
        # (2) A module is not loaded for the driver.

        # Check if a directory exists for the driver.
        if [ ! -z "${_LOADED_DIR_NAME}" ] &&
           [   -d "${_LOADED_DIR_NAME}" ]; then
            # Directory exists.
            # Now check that a module is not loaded for the driver.
            lsmod | grep -iq ${_DRIVER_NAME}
            if [ $? != 0 ]; then
                # A module is not loaded for the driver.
                # The driver is built into the kernel.
                _DRIVER_BUILTIN=$_TRUE
                break
            fi
        fi
    done

    return $_DRIVER_BUILTIN
}

# Rebuild package to support multiple kernels
rebuild() {
    # Check for root user privilege for execution of rebuild
    [ "$UID" -ne "$_ROOT_UID" ] &&
        msgErr "Package rebuilding requires 'root' user privileges."

    test -w "$PWD" ||
        msgErr "Cannot rebuild package $_PACKAGENAME-$_REBUILT_PKG_SFX in directory $PWD.  "\
            "Directory is not writable."

    typeset _CURR_KERNEL_VER=`uname -r`
    # Mark the GCC Compiler Version
    typeset _GCC_VERSION=`cat /proc/version | cut -f7 -d" "`
    extract "$_TARGET_DIR" ||
        msgErr "Rebuilding Package Failed - Unable to extract package contents."
    local _LOC_DISNEY_INSTALL=$(find "$_TARGET_DIR" -name "$_DISNEY_INSTALL")
    [ ! -f "$_LOC_DISNEY_INSTALL" ] && 
        msgErr "Package Rebuilding not supported by this package $_LOC_DISNEY_INSTALL."
    typeset -r _LOC_DISNEY_INSTALL_DIR=$(dirname "$_LOC_DISNEY_INSTALL")
    typeset -r _DRIVER_DIR=$_LOC_DISNEY_INSTALL_DIR/$_REBUILT_BASE_DIR/$_CURR_KERNEL_VER/$_GCC_VERSION

    # Disclaimer and announcement
    msgFmt "In no event shall Dell Inc. be held liable for any direct, " \
        "indirect, incidental, special, or consequential damages suffered "\
        "during or after package customization and execution."
    echo
    msgFmt "Rebuilding package $_PACKAGENAME to support kernel version `uname -r`"
    msgFmt "This process may take several minutes to complete..."


    ## START - install HAPI in hapi folder (perform no cd's until END)
    cd "$_LOC_DISNEY_INSTALL_DIR" > /dev/null 2>&1
    # Check if Server Administrator is already installed on the System.
    # Following command will return 2 if no drivers are installed on target system
    ./$_DISNEY_INSTALL checkstatus
    [ $? -ne 2 ] &&
        msgErr "Rebuilding Package Failed - Server Administrator device driver (HAPI) " \
        "is already installed on the system. Package can be rebuilt only on a system " \
        "that does not have Server Administrator device driver (HAPI) installed."

    # Check in AddnKernelSupport directory if support for this kernel already exists
    # Support Directory Format <BaseDir>/<KernelVersion>/<GCC Version>
    [ -d $_DRIVER_DIR ] &&
        msgErr "Rebuilding Package - Kernel $_CURR_KERNEL_VER is already supported by this package."

    # Check if any of the HAPI device drivers are currently built into the kernel.
    areHapiDriversBuiltIn
    [ $? -eq $_TRUE ] &&
        msgErr "Rebuilding Package Failed - One or more Server Administrator " \
        "device drivers (HAPI) are built into the kernel. Package can be " \
        "rebuilt only on a system that does not have Server Administrator " \
        "device drivers (HAPI) built into the kernel. The Server " \
        "Administrator device drivers (HAPI) are: ${_HAPI_DRIVERS}"

    ./$_DISNEY_INSTALL install
    typeset rc=$?
    [ $rc -ne 0 ] && {
        grep -i "kernel source" /var/log/dell/disneyinstall.log >/dev/null 2>&1 && 
            msgFmt \
            "Unable to build a device driver for the running kernel because " \
            "the needed kernel source files are not installed. " \
            "See \"Rebuilding Packages\" in the Update Package User's Guide."
        msgErr "Rebuilding Package Failed - RPM installation failed with error code=$rc"
    }

    [ ! -d $_DRIVER_DIR ] && mkdir -p --mode=700 $_DRIVER_DIR || {
        ./$_DISNEY_INSTALL uninstall
        msgErr "Rebuilding Package Failed - Error creating driver support directory."
    }

    # Kernel modules for kernels equal to or less than 2.4 have a file extension of ".o".
    # Kernel modules for kernels greater than 2.4 have a file extension of ".ko".
    # Determine if target kernel is greater than 2.4 kernel, and set the
    # kernel modules file extension appropriately.
    _CURR_KERNEL_VER_MAJOR=$(echo ${_CURR_KERNEL_VER} | sed "s/\..*//")
    _CURR_KERNEL_VER_MAJOR_REVISION=$(echo ${_CURR_KERNEL_VER} | sed "s/.\.//" | sed "s/\..*//")
    if [ ${_CURR_KERNEL_VER_MAJOR} -gt 2 ]; then
        typeset -r _MODEXT="ko"
    elif [ ${_CURR_KERNEL_VER_MAJOR} -eq 2 ] && [ ${_CURR_KERNEL_VER_MAJOR_REVISION} -gt 4 ]; then
        typeset -r _MODEXT="ko"
    else
        typeset -r _MODEXT="o"
    fi

    # Set the name and location of the kernel specific modules.
    typeset -r _DELL_RBU_MODULE="/lib/modules/${_CURR_KERNEL_VER}/kernel/drivers/firmware/dell_rbu.${_MODEXT}"
    typeset -r _DCDBAS_MODULE="/lib/modules/${_CURR_KERNEL_VER}/kernel/drivers/firmware/dcdbas.${_MODEXT}"

    # Locate kernel specific modules...
    # Note that two modules may exist: dell_rbu and dcdbas
    # However, only the dell_rbu module will exist on all systems.
    # The dcdbas module is applicable to only non-IPMI systems
    # and will exist only on non-IPMI systems.
    # Thus check for just the dell_rbu module.
    [ -n "$(ls $_DELL_RBU_MODULE 2>/dev/null)" ] || {
        ./$_DISNEY_INSTALL uninstall
        msgErr \
            "Rebuilding Package Failed - required kernel module is not present:  $_DELL_RBU_MODULE"
    }

    # Copy the dell_rbu module...
    cp -f $_DELL_RBU_MODULE $_DRIVER_DIR || {
        ./$_DISNEY_INSTALL uninstall
        msgErr "Rebuilding Package Failed - Error copying kernel module:  $_DELL_RBU_MODULE"
    }

    # If it exists, copy the dcdbas module...
    if [ -f ${_DCDBAS_MODULE} ]; then
        cp -f $_DCDBAS_MODULE $_DRIVER_DIR || {
            ./$_DISNEY_INSTALL uninstall
            msgErr "Rebuilding Package Failed - Error copying kernel module:  $_DCDBAS_MODULE"
        }
    fi
    cd - > /dev/null 2>&1 # Return to the original directory
    ## END - install HAPI in hapi folder

    ## START - tar up custom DUP (perform no cd's until END)
    # tar up rebuilt package
    cd "$_TARGET_DIR" > /dev/null 2>&1
    typeset _TEMP_REBUILT_TARFILE=$(mktemp $_TMPFILE_PREFIX-Tar$$-$RANDOM.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_REBUILT_TARFILE "
    typeset vopt
    [ $_VERBOSE -eq 1 ] && vopt=v
    tar -c${vopt}zf $_TEMP_REBUILT_TARFILE * || {
        cd - > /dev/null 2>&1 # Return to the original directory
        cd "$_LOC_DISNEY_INSTALL_DIR" > /dev/null 2>&1
        ./$_DISNEY_INSTALL uninstall
        cd - > /dev/null 2>&1 # Return to the original directory
        msgErr "Rebuilding Package Failed - Error recreating archive."
        # msgErr exits script
    }
    cd - > /dev/null 2>&1 # Return to the original directory
    ## END - tar up custom DUP

    ## START - uninstall HAPI (perform no cd's until END)
    # Uninstall disney now.
    cd "$_LOC_DISNEY_INSTALL_DIR" > /dev/null 2>&1
    ./$_DISNEY_INSTALL uninstall ||
        msgErr "Rebuilding Package Failed - Uninstallation of driver was unsuccessful."
    cd - > /dev/null 2>&1 # Return to the original directory
    ## END - uninstall HAPI

    # extract package generating script
    _TEMP_PACKAGE_GENERATOR=$(mktemp $_TMPFILE_PREFIX-Sez$$-$RANDOM.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_PACKAGE_GENERATOR "
    _extract "$_PACKAGE_GENERATOR" > $_TEMP_PACKAGE_GENERATOR ||
        msgErr "rebuild(): Error extracting $_PACKAGE_GENERATOR file."
    # extract manifest xml
    _TEMP_MANIFEST_XML=$(mktemp $_TMPFILE_PREFIX-Manifest$$-$RANDOM.XXXXXX) ||
        msgErr "Cannot create temporary file - TEMP_MANIFEST_XML "
    _extract "$_MANIFEST_XML" > $_TEMP_MANIFEST_XML ||
        msgErr "rebuild(): Error extracting $_MANIFEST_XML file."


    # build new package from generator, manifest, and rebuilt package
    cp "$_TARGET_DIR/$_PACKAGE_NL" . 
    _buildPackage $_TEMP_PACKAGE_GENERATOR $_TEMP_MANIFEST_XML $_TEMP_REBUILT_TARFILE \
        > $_PACKAGENAME-$_REBUILT_PKG_SFX ||
        msgErr "Rebuilding Package Failed - Error creating output package."
    chmod 1544 $_PACKAGENAME-$_REBUILT_PKG_SFX 2>/dev/null
    rm -f $_TEMP_REBUILT_TARFILE 
    rm -f $_PACKAGE_NL

    msgFmt "Package has been rebuilt successfully."
    msgFmt "Output package: $_PACKAGENAME-$_REBUILT_PKG_SFX"
}

# Display script usage
usage() {
    extract "$_TARGET_DIR"
    (
    typeset -r _LOC_DISNEY_INSTALL=$(find "$_TARGET_DIR" -name "$_DISNEY_INSTALL")
    if [ ! -f "$_LOC_DISNEY_INSTALL" ]; then
        grep  -v "^ *\-\-rebuild" "$_TARGET_DIR"/$_HELP_TEXT
    else
        cat "$_TARGET_DIR"/$_HELP_TEXT
    fi
    ) | fmt -s -w $_WIDTH
    exit $_EXECUTION_SUCCESS
}

# Verify existence of a valid option argument
verifyOptionArg() {
    typeset -r arg="$1"
    echo "$arg" | grep "^-" 2>&1 >/dev/null && return $_FALSE
    [ -z "$arg" ] && return $_FALSE
    return $_TRUE
}

###############################################################################
# Main() Script
###############################################################################
# Verify security dependencies before setting signal traps
verifySecurity "rpm stat stty cut fmt tty tar gzip tail rm mkdir mktemp chmod ls basename dirname wc sleep"

# Handle Abnormal exit conditions
trap "EndScript" EXIT
trap "InterruptScript 99" HUP INT QUIT BUS SEGV PIPE TERM # 1 2 3 10 11 13 15

typeset -r _PACKAGENAME=$(basename "$0")
typeset -r _PACKAGE_WORKDIR=$(dirname "$0")

# stty requires a terminal to get the window width
[ "$(uname -s)" == "Linux" ] && {
    # Linux only
    tty -s && _WIDTH=$(stty size | cut -f2 -d' ')
}

# Target Directory for extraction is not readonly; modifiable via '--extract' option
typeset _TARGET_DIR=/tmp/$_PACKAGENAME-$$-$RANDOM
typeset _TARGET_DIR_VALIDATE
typeset -r _TEMPDIR="$_TARGET_DIR"

# Change to working directory
cd "$_PACKAGE_WORKDIR" > /dev/null 2>&1

typeset -r _SHORT_OPTS="vhdxfqncr"
typeset -r _LONG_OPTS="\
verbose,\
version,\
help,\
buildVer,\
listXml,\
payload:,\
package:,\
extract:,\
list,\
rebuild,\
debuginv,\
xml,\
force:"

# '--' as a first or last argument is invalid
# '--' will be set as a valid last argument by 'set --' command below
eval _last_arg=\$$#
[ "$1" = "--"  -o "$_last_arg" = "--" ] && {
    msgFmt "Invalid option: --"
    usage
}

typeset -r _HELP_OPTS=$(echo "$@" | egrep -e "-\?|-help")
typeset -r _EXTRACT_OPTS=$(echo "$@" | grep "\-\-extract")
[ -n "$_EXTRACT_OPTS" ] && export GETOPT_COMPATIBLE=1 # must use old getopt
[ -n "$_HELP_OPTS" ] && set -- -h # change -? to -h
typeset _OPTOUT
getopt -T > /dev/null 2>&1
typeset _GETOPT_RC=$?
if [ $_GETOPT_RC -eq 4 ]; then
    # Enhanced version of getopt is available
    # to parse and report its option parsing errors.
    _OPTOUT=$(getopt -l $_LONG_OPTS $_SHORT_OPTS "$@" 2>&1 >/dev/null)
    [ $? -ne 0 ] && {
        msgFmt "$(echo "$_OPTOUT" | sed 's,getopt:,,g')"
        usage
    }
    set -- $(getopt -u -l $_LONG_OPTS $_SHORT_OPTS "$@")
fi

# check options over here..
typeset -i _LIMIT=0
while [ -n "$1" ]; do
    case $1 in
    --verbose)  # Display verbose info
        _VERBOSE=1
        shift
        ;;
    -v | --version)  # Display Version Information
        _VAL_VERSION=$_TRUE
        shift
        ;;
    -h | "-?" | --help) # Display help
        _VAL_HELP=$_TRUE
        shift
        ;;
    --buildVer)  # Display build number
        extract "$_TARGET_DIR"
        executePackage "$_TARGET_DIR" --buildVer
        exit $_EXECUTION_SUCCESS
        ;;
    --listXml)
        _VAL_LISTXML=$_TRUE
        shift
        ;;
    --payload)
        _PAYLOAD_DIR="$2"
        if verifyOptionArg "$_PAYLOAD_DIR"; then
            shift 2
        else
            _PAYLOAD_DIR=""
            shift
        fi
        _VAL_PAYLOAD_DIR=$_TRUE
        ;;
    --package)
        _DUP_PACKAGE_NAME="$2"
        if verifyOptionArg "$_DUP_PACKAGE_NAME"; then
            shift 2
        else
            _DUP_PACKAGE_NAME=""
            shift
        fi
        _VAL_DUP_PACKAGE_NAME=$_TRUE
        ;;
    --extract)  # extract File Contents
        _TARGET_DIR_VALIDATE="$2"
        if verifyOptionArg "$_TARGET_DIR_VALIDATE"; then
            shift 2
        else
            _TARGET_DIR_VALIDATE=""
            shift
        fi
        _VAL_EXTRACT=$_TRUE
        ;;
    --extractDell)  # extract File Contents
        _TARGET_DIR_VALIDATE="$2"
        if verifyOptionArg "$_TARGET_DIR_VALIDATE"; then
            shift 2
        else
            _TARGET_DIR_VALIDATE=""
            shift
        fi
        _VAL_EXTRACT_DELL=$_TRUE
        ;;
    --list)   # Display Archive Contents
        _VAL_LIST=$_TRUE
        shift
        ;;
    --rebuild)   # Rebuild package to support multiple kernels
        _VAL_REBUILD=$_TRUE
        shift
        ;;
    ## These are passed onto the installer: spsetup.sh
    -d | --debuginv)  # Debug Inventory processing
        shift
        ;;
    -x | --xml)  # Log XML Debug Information
        shift
        ;;
    -f)  # Forces package updates that do not pass validation
        shift
        ;;
    --force) # Tiered force
        [ -n "$2" ] && shift
        shift
        ;;
    -q)  # Quiet non-interactive processing
        _VAL_QUIET=$_TRUE
        shift
        ;;
    -n)  # Continue with insecure execution
        _VAL_ALLOW_INSECURE_EXEC=$_TRUE
        shift
        ;;
    -c)  # Check validation without package update
        shift
        ;;
    -r)  # Reboot required
        shift
        ;;
    *)  # Default case - invalid option
        # If only old un-enhanced version of getopt is available,
        # this script must report option parsing errors.
        getopt -T > /dev/null 2>&1
        _GETOPT_RC=$?
        if [ $_GETOPT_RC -ne 4 ]; then
            msgFmt "Invalid option: $1"
            usage
        else
            if [ "$1" = "--" ]; then
                # options that follow the '--' option are invalid
                shift
                [ -n "$1" ] && {
                    msgFmt "Invalid option: $1"
                    usage
                }
            else
                break
            fi
        fi
        ;;
    esac
    [ $((_LIMIT++)) -gt 100 ] && msgErr "Option limit reached; Invalid option: $1"
done

# Open an xterm window for interactive processing 
# if the DUP is executed interactively (not quiet) and is not in a terminal.
! bQuiet && {
    bNoTerminal && exec xterm +ls -e $0 $_CMDOPTS
}

## Precendence: Execute these options in the following order,
##              then exit for any processed.
bHelp && usage

bVersion && {
    extract "$_TARGET_DIR"
    executePackage "$_TARGET_DIR" $_CMDOPTS
    exit $_EXECUTION_SUCCESS
}

bList && {
    # Following command displays archive contents. -l is currently being used on Windows
    # for Logging options. So using -t and --list as options for listing archive contents.
    extractDell "$_TARGET_DIR"
    ls -lRs "$_TARGET_DIR"
    exit $_EXECUTION_SUCCESS
}

bListXml && {
    printManifestXml
    exit $_EXECUTION_SUCCESS
}

# chk_Free_Space folder_to_verify required_minimum_kbytes 
# check /var here for all extract and execution options
chk_Free_Space /var $((50*1024))

bExtract || bExtractDell && {
    [ -z "$_TARGET_DIR_VALIDATE" ] &&
        msgErr "Please provide a directory name for extraction."
    [ "$_TARGET_DIR_VALIDATE" = "/" ] &&
        msgErr "ROOT directory cannot be used for extraction."
    [ -h "${_TARGET_DIR_VALIDATE%/}" ] &&
        msgFmt "Warning: Security risk, extraction directory $_TARGET_DIR_VALIDATE "\
                "is a symbolic link."
    bExtract && extract "$_TARGET_DIR" # temporary directory
    bExtractDell && extractDell "$_TARGET_DIR" # temporary directory

    # Move contents of temporary directory to target directory
    createExtractDir "$_TARGET_DIR_VALIDATE"
    find "$_TARGET_DIR" | xargs chmod 1755
    find "$_TARGET_DIR_VALIDATE" | xargs chmod 1755
    mv $_TARGET_DIR/* "$_TARGET_DIR_VALIDATE"
    msgFmt "Successfully extracted to $_TARGET_DIR_VALIDATE"
    exit $_EXECUTION_SUCCESS
}

bRebuild && {
    rebuild
    exit $_EXECUTION_SUCCESS
}

bPayloadDir && {
    [ -z "$_PAYLOAD_DIR" -o ! -d "$_PAYLOAD_DIR" ] &&
        msgErr "Please provide a directory name for the payload."
    [ "$_PAYLOAD_DIR" = "/" ] &&
        msgErr "ROOT directory cannot be used for the payload."
    [ -h "{$_PAYLOAD_DIR%/}" ] &&
        msgFmt "Warning: Security risk, payload directory $_PAYLOAD_DIR is a symbolic link."
}

bDupPackage && {
    [ -z "$_DUP_PACKAGE_NAME" ] &&
        msgErr "Please provide a name for the DUP package."
}

generateNewDup
extract "$_TARGET_DIR"
# Check for root user privilege for execution of package
[ "$UID" -ne "$_ROOT_UID" ] &&
    msgErr "Package execution requires 'root' user privileges."

executePackage "$_TARGET_DIR" $_CMDOPTS
exit $_PACKAGE_STATUS
#####Startofpackage#####
